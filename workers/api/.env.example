# iii.dev API — runtime config. On Fly.io these come from `fly secrets`.
PORT=8080
FLY_PRIMARY_REGION=lhr
# Pooled least-privilege runtime role (commerce_db only; non-superuser).
# See packages/commerce-db/sql/provision-roles.sql for how the role is created.
COMMERCE_DATABASE_URL=postgresql://commerce_rt:PASSWORD@HOST/commerce_db?sslmode=require
# Shared secret + audience for the signed Payload → iii.dev catalogue sync.
PAYLOAD_COMMERCE_SYNC_SECRET=change-me
III_SYNC_AUDIENCE=iii-catalog-sync
# Stripe (Fly secrets in production). Without STRIPE_SECRET_KEY, checkout is simulated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=change-me
STOREFRONT_URL=http://localhost:3001
# Tracking (AfterShip in production): TRACKING_PROVIDER=aftership + AFTERSHIP_WEBHOOK_SECRET.
TRACKING_WEBHOOK_SECRET=change-me
