# iii.dev API — runtime config. On Fly.io these come from `fly secrets`.
PORT=8080
FLY_PRIMARY_REGION=lhr
# Pooled least-privilege runtime role (commerce_db only; non-superuser).
# See packages/commerce-db/sql/provision-roles.sql for how the role is created.
COMMERCE_DATABASE_URL=postgresql://commerce_rt:PASSWORD@HOST/commerce_db?sslmode=require
