# ---------------------------------------------------------------------------
# DogFood Platform — example environment. Copy per app; NEVER commit real values.
# Secrets are split by deployment so no project holds credentials it must not.
# See vercel-domain-deployment-spec.md §10.
# ---------------------------------------------------------------------------

# --- apps/payload-crm (Vercel project B → crm.yourdogfood.co.uk) ---
# Payload owns payload_db ONLY. Never give it commerce credentials.
DATABASE_URL=postgresql://payload_runtime:PASSWORD@HOST/payload_db?sslmode=require
PAYLOAD_SECRET=change-me

# --- apps/storefront (Vercel project A → www.yourdogfood.co.uk) ---
# Better Auth customer identity + server-only commerce access.
NEXT_PUBLIC_APP_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me
COMMERCE_DATABASE_URL=postgresql://commerce_runtime:PASSWORD@HOST/commerce_db?sslmode=require
III_API_BASE_URL=http://localhost:8080

# --- packages/commerce-db migrations (controlled CI job only) ---
COMMERCE_MIGRATION_DATABASE_URL=postgresql://commerce_migrator:PASSWORD@HOST/commerce_db?sslmode=require

# --- iii.dev workers on Fly.io (api.yourdogfood.co.uk) — not deployed from Vercel ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RABBITMQ_URL=
# RESEND_API_KEY=
# TRACKING_PROVIDER=aftership
# AFTERSHIP_API_KEY=
